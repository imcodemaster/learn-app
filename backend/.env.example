# LearnInCreation backend settings.
# Copy this file to ".env" and edit it. Keep comments on their own lines.
# Never commit your real .env file or share it.

# ---------------------------------------------------------------- Core
# 1 only on your own computer while developing; 0 on the live server.
DJANGO_DEBUG=1
# "local" for development/testing, "production" on the live server.
APP_ENV=local
# Long random string (50+ characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
# Domains/IPs the server answers to (comma separated). 10.0.2.2 = Android emulator.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# Needed for the admin panel on a live site, e.g. https://api.learnincreation.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Public address of this server (used for image links), e.g. https://api.learnincreation.com
PUBLIC_BASE_URL=
# Admin panel path. Pick something hard to guess for the live site, e.g. manage-li-7k2/
ADMIN_URL=admin/

# ---------------------------------------------------------------- Database
# sqlite (simple, for trying things out) | postgres (recommended live) | mysql
DB_ENGINE=sqlite
DB_NAME=learnincreation
DB_USER=learnincreation
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ---------------------------------------------------------------- HTTPS / proxy
# Set both when running behind Nginx or a hosting platform's load balancer.
DJANGO_BEHIND_PROXY=0
NUM_PROXIES=0

# ---------------------------------------------------------------- Mobile OTP (SMS)
# console = codes are printed in the server log (testing only)
# msg91 | fast2sms | twilio = real SMS (Indian providers need DLT registration)
SMS_BACKEND=console
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
FAST2SMS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------------------------------------------------------------- Email (password reset codes)
# Console backend prints emails in the server log. For real email use:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=LearnInCreation <no-reply@learnincreation.com>

# ---------------------------------------------------------------- Google sign-in
# Your OAuth "Web application" client ID (comma separate several).
GOOGLE_CLIENT_IDS=

# ---------------------------------------------------------------- Razorpay
# mock = simulated payments for testing (automatically disabled when APP_ENV=production)
# razorpay = real payments (use rzp_test_... keys first, then rzp_live_...)
PAYMENTS_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------- Optional
# Shared cache for rate limits when running several server processes:
#   CACHE_URL=redis://localhost:6379/0   (pip install redis)   or   CACHE_URL=db
CACHE_URL=
# Minutes a study-center seat is held while the student pays.
BOOKING_HOLD_MINUTES=10
# Where uploaded images are stored.
# MEDIA_ROOT=/var/www/learnincreation/media
SERVE_MEDIA=1
